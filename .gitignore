# Default deny: never stage an archive, browser profile or credential accidentally.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/README.md
!/docs/
/docs/*
!/docs/notes/
!/docs/ESTRUTURA.md
!/work/
/work/*
!/work/tce-extractor/
/work/tce-extractor/*
!/work/tce-extractor/*.py
/work/tce-extractor/.codex-live-pilot.py
!/work/tce-extractor/*.ps1
!/work/tce-extractor/*.bat
!/work/tce-extractor/QA-DEPENDENCIAS.md
!/work/tce-extractor/requirements-qa.txt
!/work/tce-extractor/docs/
!/work/tce-extractor/docs/notes/
!/work/tce-extractor/docs/notes/*.md
!/work/tce-extractor/tests/
!/work/tce-extractor/portable/
/work/tce-extractor/portable/*
!/work/tce-extractor/portable/runtime-manifest.json
!/work/tce-extractor/portable/licenses/
!/work/tce-extractor/portable/licenses/README.md
!/work/tce-extractor/portable/*.ps1
!/work/tce-extractor/portable/*.psm1
!/work/tce-extractor/portable/*.js
!/work/tce-extractor/portable/*.cmd
!/work/tce-extractor/portable/*.bat
!/work/tce-extractor/portable/GUIA-RAPIDO.*
!/work/tce-extractor/portable/README.md
!/work/tce-extractor/portable/app/
/work/tce-extractor/portable/app/*
!/work/tce-extractor/portable/app/*.py
!/work/tce-extractor/portable/app/*.ps1
!/work/tce-extractor/portable/app/area_snapshot_transfer.html
!/work/tce-extractor/portable/app/web/
!/work/tce-extractor/portable/app/web/**
!/work/tce-extractor/portable/extensao-complementar-ato/
/work/tce-extractor/portable/extensao-complementar-ato/*
!/work/tce-extractor/portable/extensao-complementar-ato/manifest.json
!/work/tce-extractor/portable/extensao-complementar-ato/package.json
!/work/tce-extractor/portable/extensao-complementar-ato/background/
!/work/tce-extractor/portable/extensao-complementar-ato/content/
!/work/tce-extractor/portable/extensao-complementar-ato/lib/
!/work/tce-extractor/portable/extensao-complementar-ato/sidepanel/
!/work/tce-extractor/portable/extensao-complementar-ato/tests/
# Root Mesa application: the default-deny allowlist for the new source tree.
!/app/
/app/*
!/app/**
!/extension/
/extension/*
!/extension/**
!/packaging/
/packaging/*
!/packaging/**
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.ps1
!/tests/
/tests/*
!/tests/**
!/START.cmd

# New runtime data, build output and scratch areas are never versioned.
/data/
/dist/
/tmp/

**/__pycache__/
**/node_modules/
**/.pytest_cache/
**/*.pdf
**/*.zip
**/*.log
**/runtime/
# The promoted e-Contas runtime is code the Mesa executes, not build output:
# the collector and its modules must travel with the repository, otherwise a
# clone would run a different download engine than the one reviewed here.
!app/econtas/runtime/
!app/econtas/runtime/**

# Portal Lab is development-only. Version only sanitized tools/contracts;
# keep raw captures and local Playwright state private.
!/devtools/
!/devtools/area-restrita/
!/devtools/area-restrita/README.md
!/devtools/area-restrita/*.json
!/devtools/area-restrita/fixtures/
!/devtools/area-restrita/fixtures/*.json
!/.agents/
!/.agents/skills/
!/.agents/skills/area-restrita/
!/.agents/skills/area-restrita/SKILL.md
!/.agents/skills/area-restrita/references/
!/.agents/skills/area-restrita/references/*.md
!/scripts/portal-lab/
!/scripts/portal-lab/*.ps1
!/scripts/portal-lab/*.py
!/scripts/portal-lab/*.js
/tmp/portal-lab/
/.playwright-cli/

**/dados-locais/
**/acervo-tce/
**/backups-acervo/
**/profile/
**/.env*
