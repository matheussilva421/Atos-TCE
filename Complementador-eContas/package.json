{
  "name": "complementador-econtas",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "description": "Extensão Chrome independente para complementação assistida de atos no e-Contas do TCE/RN.",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "node --test --test-force-exit --test-concurrency=1 tests/browser/*.spec.mjs",
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "benchmark": "node tests/browser/benchmark.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "jsdom": "26.0.0",
    "pdfjs-dist": "4.10.38",
    "playwright": "1.50.1"
  }
}
