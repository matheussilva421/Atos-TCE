{
  "manifest_version": 3,
  "name": "Complementador e-Contas",
  "version": "2.0.5",
  "description": "Preenche o Complementar Ato a partir dos autos; a automação em lote só inicia com autorização explícita.",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": [
    "https://processos.tce.rn.gov.br/*",
    "https://novaarearestrita.tce.rn.gov.br/as/consultaprocessotemp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://processos.tce.rn.gov.br/*"],
      "js": ["autos-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://processos.tce.rn.gov.br/*"],
      "js": ["form-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://processos.tce.rn.gov.br/*"],
      "js": ["list-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/pdf.worker.mjs"],
      "matches": ["https://processos.tce.rn.gov.br/*"]
    }
  ]
}
